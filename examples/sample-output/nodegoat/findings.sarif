          "message": {
            "text": "Session cookie signing secret\n\nFixed session-signing secret hard-coded in the shared default configuration module, with no environment-variable override and no production-specific value."
          },
          "ruleId": "secret-scanning/high",
          "ruleIndex": 14
        },
        {
