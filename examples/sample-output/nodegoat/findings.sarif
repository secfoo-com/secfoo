            }
          ],
          "message": {
            "text": "RSA private key (TLS)\n\nUnencrypted PEM private key committed to the repository next to its certificate and read from disk by the web server at startup to serve HTTPS."
          },
          "ruleId": "secret-scanning/high",
          "ruleIndex": 14
        }
