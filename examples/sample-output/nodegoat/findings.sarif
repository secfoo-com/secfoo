                }
              }
            }
          ],
          "message": {
            "text": "Seeded admin & user passwords\n\nDefault administrator and user passwords written in plaintext inside the database seed script that runs automatically on deploy."
          },
          "ruleId": "secret-scanning/medium",
          "ruleIndex": 13
        },
        {
