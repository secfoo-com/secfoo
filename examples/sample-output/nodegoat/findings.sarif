          ],
          "message": {
            "text": "OWASP ZAP API key\n\nHigh-entropy security-scanner API key hard-coded in development and test configuration files alongside the scanner's internal network address."
          },
          "ruleId": "secret-scanning/medium",
          "ruleIndex": 13
        },
